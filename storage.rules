service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                      request.resource.contentType.matches('image/.*');
    }
    
    // Product images
    match /products/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Slide banners
    match /slides/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
